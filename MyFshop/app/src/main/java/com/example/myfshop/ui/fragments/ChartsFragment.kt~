    private fun getRevenueDataByMonth() {
        // Show a loading dialog if necessary (optional)
        // showProgressDialog("Please wait...")

        FirestoreClass().getAllOrders { ordersList ->
            val revenueData = calculateMonthlyRevenue(ordersList)
            setupRevenueChart(revenueData)
            setupLineChart(revenueData)
            setupPieChart(ordersList)
        }
    }

    private fun calculateMonthlyRevenue(ordersList: List<Order>): List<BarEntry> {
        val revenueByMonth = mutableMapOf<Int, Float>()

        val dateFormat = SimpleDateFormat("yyyy-MM", Locale.getDefault())

        // Loop through orders and calculate monthly revenue
        ordersList.forEach { order ->
            val monthYear = dateFormat.format(Date(order.order_datetime))
            val month = monthYear.substring(5, 7).toInt()  // Get the month (MM)

            val totalAmount = order.total_amount.toFloat()

            revenueByMonth[month] = revenueByMonth.getOrDefault(month, 0f) + totalAmount
        }

        // Prepare data for the bar chart
        val revenueEntries = ArrayList<BarEntry>()
        revenueByMonth.forEach { (month, revenue) ->
            revenueEntries.add(BarEntry(month.toFloat(), revenue))
        }

        return revenueEntries
    }

    private fun setupRevenueChart(revenueData: List<BarEntry>) {
        // Create BarDataSet for the chart
        val dataSet = BarDataSet(revenueData, "Monthly Revenue")
        dataSet.color = resources.getColor(R.color.colorPrimary)  // Set color for the bars

        // Create BarData and set it to the chart
        val barData = BarData(dataSet)
        chartRevenue.data = barData

        // Customize chart appearance
        chartRevenue.description.isEnabled = false  // Disable description text
        chartRevenue.animateY(1000)  // Add animation

        // Set labels for the X-axis (Months)
        val months = arrayOf("Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec")
        val xAxis = chartRevenue.xAxis
        xAxis.valueFormatter = IndexAxisValueFormatter(months)
        xAxis.position = com.github.mikephil.charting.components.XAxis.XAxisPosition.BOTTOM

        // Refresh chart
        chartRevenue.invalidate()
    }
