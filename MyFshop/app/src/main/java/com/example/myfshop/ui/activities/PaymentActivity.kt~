package com.example.myfshop.ui.activities

import android.content.Intent
import android.os.Bundle
import android.widget.*
import androidx.appcompat.app.AppCompatActivity
import com.example.myfshop.R
import com.example.myfshop.models.Order
import com.example.myfshop.utils.Constants

class PaymentActivity : AppCompatActivity() {

    private lateinit var radioGroupPaymentMethod: RadioGroup
    private lateinit var radioButtonCOD: RadioButton
    private lateinit var radioButtonOnline: RadioButton
    private lateinit var buttonConfirmPayment: Button

    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        setContentView(R.layout.activity_payment)

        // Ánh xạ các view từ layout
        radioGroupPaymentMethod = findViewById(R.id.payment_method_group)
        radioButtonCOD = findViewById(R.id.rb_cod)
        radioButtonOnline = findViewById(R.id.rb_online_payment)
        buttonConfirmPayment = findViewById(R.id.btn_confirm_payment)

        // Xử lý sự kiện click vào nút "Place Order"
        buttonConfirmPayment.setOnClickListener {
            val selectedPaymentMethodId = radioGroupPaymentMethod.checkedRadioButtonId

            // Kiểm tra phương thức thanh toán được chọn
            val selectedPaymentMethod = when (selectedPaymentMethodId) {
                R.id.rb_cod -> "COD"
                R.id.rb_online_payment -> "Online Payment"
                else -> null
            }

            if (selectedPaymentMethod != null) {
                // Cập nhật phương thức thanh toán đã chọn
                Toast.makeText(this, "Payment Method: $selectedPaymentMethod", Toast.LENGTH_SHORT).show()

                // Xử lý logic thanh toán tương ứng
                if (selectedPaymentMethod == "COD") {
                    handleCODPayment()
                } else {
                    handleOnlinePayment()
                }
            } else {
                Toast.makeText(this, "Please select a payment method.", Toast.LENGTH_SHORT).show()
            }
        }
    }

    private fun handleCODPayment() {
        // Logic hoàn thành đơn hàng
        completeOrder()

        // Hiển thị thông báo thành công
        Toast.makeText(this, "Order placed successfully! Payment mode: Cash on Delivery", Toast.LENGTH_LONG).show()

        // Chuyển về màn hình chính hoặc trang khác nếu cần
        finish() // Hoặc khởi động activity khác nếu bạn muốn
    }

    private fun handleOnlinePayment() {
        // Chuyển người dùng đến màn hình nhập thông tin thanh toán trực tuyến
        val intent = Intent(this, OnlinePaymentActivity::class.java)
        startActivity(intent)
    }

    private fun completeOrder() {
